{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "altura",
  "compatibility_date": "2025-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "qilo.one/altura", "zone_name": "qilo.one" },
    { "pattern": "qilo.one/altura/*", "zone_name": "qilo.one" },
    { "pattern": "qilo.one/altura-mockup", "zone_name": "qilo.one" },
    { "pattern": "qilo.one/altura-mockup/*", "zone_name": "qilo.one" },
    { "pattern": "alturainvestama.com", "custom_domain": true },
    { "pattern": "www.alturainvestama.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
